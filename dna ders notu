function Helix(canvas,o){
  const ctx=canvas.getContext('2d');let t=0,run=!reduce,flat=0,target=0,W=0,H=0;
  const seq=o.seq||'ATGCCGTAAGCTTGACGATC';
  function css(v){return getComputedStyle(document.documentElement).getPropertyValue(v).trim()}
  function resize(){const r=canvas.getBoundingClientRect();if(!r.width)return;const d=devicePixelRatio||1;W=r.width;H=r.height;canvas.width=W*d;canvas.height=H*d;ctx.setTransform(d,0,0,d,0,0);draw()}
  function draw(){if(!W)return;ctx.clearRect(0,0,W,H);
    const pad=24,n=Math.max(8,Math.min(seq.length,Math.floor((W-2*pad)/26))),st=(W-2*pad)/(n-1),cy=H/2,R=Math.min(H*.36,70),f=flat;
    const col={A:css('--A'),T:css('--T'),G:css('--G'),C:css('--C')},bb=css('--bb'),ink=css('--ink');
    const yAt=(i,s)=>{const ph=i*.55+t;const c=Math.cos(ph)*(1-f)+f;return cy+s*R*c};
    const zAt=i=>Math.sin(i*.55+t)*(1-f);
    // basamaklar
    for(let i=0;i<n;i++){const x=pad+i*st,y1=yAt(i,1),y2=yAt(i,-1),m=(y1+y2)/2,b=seq[i%seq.length],a=.55+.45*(1-Math.abs(zAt(i))*.5);
      ctx.globalAlpha=a;ctx.lineWidth=5;ctx.lineCap='round';
      ctx.strokeStyle=col[b];ctx.beginPath();ctx.moveTo(x,y1);ctx.lineTo(x,m-(f>.9?2:0));ctx.stroke();
      ctx.strokeStyle=col[COMP[b]];ctx.beginPath();ctx.moveTo(x,m+(f>.9?2:0));ctx.lineTo(x,y2);ctx.stroke();
      if(o.labels&&f>.6){ctx.globalAlpha=(f-.6)/.4;ctx.fillStyle=ink;ctx.font='600 12px "IBM Plex Mono",monospace';ctx.textAlign='center';
        ctx.fillText(b,x,cy+R+18);ctx.fillText(COMP[b],x,cy-R-9);
        if(i%1===0){ctx.fillStyle=css('--muted');ctx.font='600 9px "IBM Plex Mono",monospace';ctx.fillText(b==='A'||b==='T'?'||':'|||',x,cy+3)}}
    }
    ctx.globalAlpha=1;
    // omurgalar
    [1,-1].forEach(s=>{ctx.strokeStyle=bb;ctx.lineWidth=6;ctx.beginPath();for(let k=0;k<=(n-1)*6;k++){const i=k/6,x=pad+i*st,y=yAt(i,s);k?ctx.lineTo(x,y):ctx.moveTo(x,y)}ctx.stroke()});
    if(o.labels&&f>.6){ctx.globalAlpha=(f-.6)/.4;ctx.fillStyle=css('--muted');ctx.font='700 11px Nunito,sans-serif';ctx.textAlign='left';ctx.fillText('şeker-fosfat',pad,cy-R-24>10?cy-R-24:12);ctx.globalAlpha=1}
  }
  function loop(){if(run)t+=.012;flat+=(target-flat)*.08;draw();requestAnimationFrame(loop)}
  addEventListener('resize',resize);resize();requestAnimationFrame(loop);
  return{resize,toggle(){run=!run;return run},setFlat(v){target=v;if(v)run=false},isRun:()=>run}
}
