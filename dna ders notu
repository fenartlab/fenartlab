function matSolve(m){const base=m.A+m.T+m.G+m.C,free=Math.min(m.P,m.S,base);
  const lim=[['fosfat',m.P],['şeker',m.S],['organik baz',base]].filter(x=>x[1]===free).map(x=>x[0]).join(' ve ');
  const at=Math.min(m.A,m.T),gc=Math.min(m.G,m.C),want=at+gc,cap=Math.floor(Math.min(m.P,m.S)/2),pairs=Math.min(want,cap);
  const fl=['Toplam baz = '+m.A+' + '+m.T+' + '+m.G+' + '+m.C+' = '+base,'Fosfat '+m.P+' · Şeker '+m.S+' · Baz '+base,'En az olan: '+lim+' → <b>'+free+' serbest nükleotid</b>'];
  const dl=['A-T çifti = '+m.A+' ve '+m.T+' sayısından az olan = '+at,'G-C çifti = '+m.G+' ve '+m.C+' sayısından az olan = '+gc,'Baz çifti = '+want+' → '+2*want+' fosfat ve '+2*want+' şeker gerekir'];
  if(cap<want)dl.push('Ama '+(m.P<=m.S?'fosfat ('+m.P+')':'şeker ('+m.S+')')+' en fazla '+cap+' çifte yeter → baz çifti = '+cap);
  else dl.push(m.P+' fosfat ve '+m.S+' şeker yeterli');
  dl.push('DNA = 2 × '+pairs+' = <b>'+2*pairs+' nükleotid</b> ('+pairs+' baz çifti)');
  return{free,fl,pairs,dna:2*pairs,dl,leftP:m.P-2*pairs,leftS:m.S-2*pairs}}
