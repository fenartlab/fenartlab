$("kHint").onclick=()=>{
  const M=MIS[KS.i];KS.hint++;
  if(KS.hint===1){KS.names=true;renderKesif();say($("kSay"),"Takımyıldızların ve parlak yıldızların isimlerini açtık. Haberde adı geçen takımyıldızı bul.")}
  else{O.rings=[{rdeg:M.rad*3.2,color:"#ffd27a",dash:true,_ra:M.ra,_dec:M.dec}];say($("kSay"),"Aranan cisim sarı kesikli dairenin içinde bir yerde.")}
};
function nearestCon(alt,az,maxDeg){let best=null,bd=maxDeg;for(const id in ST){if(!STAR_CON[id])continue;const p=P[id];if(p.alt<0)continue;const d=angDist(alt,az,p.alt,p.az);if(d<bd){bd=d;best=STAR_CON[id]}}return best}
function tapKesif(x,y){
  if(V.kind==="dome"&&Math.hypot(x-V.cx,y-V.cy)>V.R){return}
  const M=MIS[KS.i];const q=unproj(x,y);
  if(q.alt<0){say($("kSay"),"Orası ufkun altı. Gökyüzüne dokun.","warn");return}
  if(!KS.zoom){
    zoomTo(q.alt,q.az);const c=nearestCon(q.alt,q.az,14);
    say($("kSay"),(c?`Dürbünle <b>${CONS_BY[c].ad}</b> takımyıldızının yakınına bakıyorsun.`:"Dürbünle bakıyorsun.")+" Aradığın cisim burada mı? Ona dokun ya da <b>Bütün gökyüzü</b> düğmesiyle geri dön.");
    return}
  if(KS.found)return;
  const t=altaz(M.ra,M.dec,LST);
  if(angDist(q.alt,q.az,t.alt,t.az)<M.rad){found();return}
  KS.tries++;
  const c=nearestCon(q.alt,q.az,6);
  if(c)say($("kSay"),`Burası <b>${CONS_BY[c].ad}</b> takımyıldızı. ${KS.tries>=2?"Haberi yeniden oku ya da İpucu'ya dokun.":"Haberde ne anlatılıyordu? Biraz daha dikkatli bak."}`,"warn");
  else say($("kSay"),"Burada aranan cisim yok. Gerekirse bütün gökyüzüne dönüp başka bir yere bak.","warn");
}
function found(){
  const M=MIS[KS.i];KS.found=true;KS.done[KS.i]=true;O.rings=[{rdeg:M.rad*.9,color:"#74e3ac",_ra:M.ra,_dec:M.dec}];
  say($("kSay"),`Buldun: <b>${M.name}</b>! Aşağıdaki teleskop görüntüsüne ve bilgi kartına bak.`,"good");
  $("kScope").hidden=false;$("kScopeT").textContent=M.name;
  $("kBook").innerHTML=`<span class="tag kitap">Kitaptan</span>${M.kitap}`;
  $("kExtra").innerHTML=`<span class="tag ek">Biliyor muydun?</span>${M.ek}`;
  const all=Object.keys(KS.done).length===MIS.length;
  $("kNext").textContent=all?"Bütün haberleri buldun!":"Sonraki haber →";$("kNext").disabled=all;
  drawScope(M);renderKesif();
  $("kScope").scrollIntoView({behavior:REDUCED?"auto":"smooth",block:"nearest"});
}
$("kNext").onclick=()=>{let n=(KS.i+1)%MIS.length;for(let k=0;k<MIS.length;k++){if(!KS.done[n])break;n=(n+1)%MIS.length}startMission(n)};
// halkaları gök koordinatına bağla
function ringFollow(){for(const r of O.rings){if(r._ra!=null){const p=radecXY(r._ra,r._dec);r.x=p.x;r.y=p.y;if(r.rdeg)r.r=Math.max(16,r.rdeg*pxPerDeg(p.alt))}}}

/* ----- teleskop görüntüsü ----- */
function drawScope(M){
  const c=$("scopeCv"),g=c.getContext("2d"),S=400,r=rng(M.id.length*97+3);
  g.clearRect(0,0,S,S);g.save();g.beginPath();g.arc(S/2,S/2,S/2,0,7);g.clip();g.fillStyle="#04061a";g.fillRect(0,0,S,S);
  for(let i=0;i<160;i++){g.globalAlpha=.3+r()*.7;g.fillStyle="#fff";g.beginPath();g.arc(r()*S,r()*S,r()*1.3+.3,0,7);g.fill()}g.globalAlpha=1;
  const gl=(x,y,rad,st)=>{const q=g.createRadialGradient(x,y,0,x,y,rad);st.forEach(([o,cc])=>q.addColorStop(o,cc));g.fillStyle=q;g.beginPath();g.arc(x,y,rad,0,7);g.fill()};
  const C=S/2;
  if(M.scope==="star"){gl(C,C,150,[[0,M.col],[.12,M.col],[.3,M.col+"66"],[1,M.col+"00"]]);g.strokeStyle=M.col+"88";g.lineWidth=2;for(let a=0;a<4;a++){g.beginPath();g.moveTo(C+Math.cos(a*Math.PI/2)*30,C+Math.sin(a*Math.PI/2)*30);g.lineTo(C+Math.cos(a*Math.PI/2)*170,C+Math.sin(a*Math.PI/2)*170);g.stroke()}}
  else if(M.scope==="orion"){for(let i=0;i<70;i++){const a=r()*6.28,d=Math.pow(r(),.7)*150;gl(C+Math.cos(a)*d*1.1,C+Math.sin(a)*d*.85,40+r()*60,[[0,`rgba(${200+r()*55|0},${90+r()*80|0},${130+r()*60|0},.16)`],[1,"rgba(0,0,0,0)"]])}
    gl(C,C,90,[[0,"rgba(255,240,220,.9)"],[.3,"rgba(255,160,180,.45)"],[1,"rgba(255,120,160,0)"]]);for(let i=0;i<4;i++){g.fillStyle="#eaf2ff";g.beginPath();g.arc(C-12+i*8,C-4+(i%2)*8,3,0,7);g.fill()}}
  else if(M.scope==="horse"){gl(C,C-40,260,[[0,"rgba(230,80,90,.85)"],[.6,"rgba(160,40,70,.55)"],[1,"rgba(60,10,30,0)"]]);g.fillStyle="#05040c";g.beginPath();
    g.moveTo(120,400);g.lineTo(150,260);g.bezierCurveTo(150,200,170,170,200,150);g.bezierCurveTo(215,120,240,110,262,128);g.bezierCurveTo(270,150,252,160,248,175);g.bezierCurveTo(262,200,268,230,250,250);g.bezierCurveTo(235,260,225,250,225,280);g.lineTo(240,400);g.closePath();g.fill();
    g.beginPath();g.moveTo(205,152);g.lineTo(212,118);g.lineTo(224,142);g.fill();gl(300,90,22,[[0,"#ffffff"],[1,"rgba(255,255,255,0)"]])}
  else if(M.scope==="cluster"){gl(C,C,180,[[0,"rgba(120,160,255,.25)"],[1,"rgba(80,120,255,0)"]]);[[200,190,9],[235,215,7],[160,170,7],[185,140,6],[250,165,6],[150,235,5],[215,250,5],[275,240,4],[130,205,4]].forEach(([x,y,s])=>{gl(x,y,s*5,[[0,"#ffffff"],[.25,"rgba(200,220,255,.8)"],[1,"rgba(150,190,255,0)"]])})}
  else if(M.scope==="planet"){g.save();g.translate(C,C);g.beginPath();g.arc(0,0,70,0,7);g.clip();const bands=["#e8d2b0","#c99c6e","#efe0c6","#b98a5e","#e6cfa8","#c5976a","#eadbbf"];bands.forEach((b,i)=>{g.fillStyle=b;g.fillRect(-80,-70+i*20,160,20)});g.fillStyle="rgba(190,90,60,.8)";g.beginPath();g.ellipse(22,24,14,8,0,0,7);g.fill();g.restore();
    [[-140,4],[-100,-2],[110,3],[150,-3]].forEach(([dx,dy])=>{g.fillStyle="#fff8ec";g.beginPath();g.arc(C+dx,C+dy,4,0,7);g.fill()})}
  else if(M.scope==="comet"){g.save();g.translate(110,280);g.rotate(-.75);const q=g.createLinearGradient(0,0,330,0);q.addColorStop(0,"rgba(190,240,255,.85)");q.addColorStop(1,"rgba(190,240,255,0)");g.fillStyle=q;g.beginPath();g.moveTo(0,-10);g.quadraticCurveTo(200,-60,340,-90);g.lineTo(340,80);g.quadraticCurveTo(200,40,0,10);g.fill();g.restore();gl(110,280,40,[[0,"#ffffff"],[.3,"rgba(200,255,240,.8)"],[1,"rgba(150,230,255,0)"]])}
  else if(M.scope==="galaxy"){g.save();g.translate(C,C);g.rotate(-.6);g.scale(1,.38);gl(0,0,190,[[0,"rgba(255,245,225,1)"],[.12,"rgba(255,230,200,.85)"],[.45,"rgba(190,180,255,.35)"],[1,"rgba(120,120,255,0)"]]);g.strokeStyle="rgba(40,30,60,.5)";g.lineWidth=6;g.beginPath();g.ellipse(0,0,120,120,0,.3,2.6);g.stroke();g.restore()}
  else if(M.scope==="meteor"){for(let i=0;i<9;i++){const a=r()*6.28,d0=30+r()*30,d1=d0+80+r()*90;const q=g.createLinearGradient(C+Math.cos(a)*d0,C+Math.sin(a)*d0,C+Math.cos(a)*d1,C+Math.sin(a)*d1);q.addColorStop(0,"rgba(255,255,255,0)");q.addColorStop(1,"rgba(255,250,225,.95)");g.strokeStyle=q;g.lineWidth=3;g.beginPath();g.moveTo(C+Math.cos(a)*d0,C+Math.sin(a)*d0);g.lineTo(C+Math.cos(a)*d1,C+Math.sin(a)*d1);g.stroke()}}
  g.restore();
  // nişangâh
  g.strokeStyle="rgba(255,111,90,.35)";g.lineWidth=1.5;g.beginPath();g.moveTo(C,0);g.lineTo(C,S);g.moveTo(0,C);g.lineTo(S,C);g.stroke();
}

/* =================== MOD DEĞİŞİMİ =================== */
function setMode(m){
  mode=m;anim=null;HS.play=null;
  ["harita","orman","kesif"].forEach(k=>{$("tab-"+k).setAttribute("aria-selected",String(k===m));$("p-"+k).hidden=k!==m});
  $("turnL").hidden=$("turnR").hidden=m!=="orman";$("zoomOut").hidden=true;
  if(m==="harita"){V.kind="dome";fit();syncH()}
  else if(m==="orman"){startLevel(OS.lv)}
  else startMission(KS.i);
  $("panel").scrollTop=0;
}
["harita","orman","kesif"].forEach(k=>$("tab-"+k).onclick=()=>setMode(k));

// çizimden önce halkaları güncelle
function loop2(t){if(anim)anim(t);compute();ringFollow();draw(t);requestAnimationFrame(loop2)}
fit();setMode("harita");requestAnimationFrame(loop2);
})();
</script>

