<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Yıldız Pusulası</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700&family=Lexend:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
/* Düzen: solda büyük gökyüzü (kubbe ya da orman panoraması), sağda kırmızı fener ışığında bir gözlem defteri paneli. Tek tema: gece. */
:root{
  --night:#080c1d;      /* sayfa zemini */
  --panel:#10162f;      /* defter paneli */
  --panel2:#161e3e;     /* kart */
  --line:#28325e;       /* ince çizgiler */
  --ink:#eceffa;        /* metin */
  --muted:#a2abd0;      /* ikincil metin */
  --red:#ff6f5a;        /* kırmızı fener: gözlemcinin ışığı */
  --redsoft:rgba(255,111,90,.16);
  --gold:#ffd27a;       /* seçili takımyıldız */
  --ok:#74e3ac;
  --okSoft:rgba(116,227,172,.14);
  --bad:#ff9a8f;
  --f-disp:"Unbounded","Trebuchet MS",system-ui,sans-serif;
  --f-body:"Lexend","Segoe UI",system-ui,sans-serif;
  --f-mono:"IBM Plex Mono",ui-monospace,Consolas,monospace;
  color-scheme:dark;
}
[hidden]{display:none!important}
html,body{height:100%}
body{background:var(--night);color:var(--ink);font-family:var(--f-body);font-size:16px;line-height:1.45;margin:0}
*{box-sizing:border-box}
button{font:inherit;color:inherit}
.app{height:100%;display:grid;grid-template-rows:auto minmax(0,1fr);gap:12px;padding-block:12px;padding-inline:16px}
header{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.brand{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap;margin-right:auto}
.brand h1{font-family:var(--f-disp);font-weight:700;font-size:1.45rem;letter-spacing:.01em;margin:0}
.brand h1 span{color:var(--red)}
.brand p{margin:0;color:var(--muted);font-size:.85rem;letter-spacing:.06em;text-transform:uppercase}
.tabs{display:flex;gap:6px;flex-wrap:wrap}
.tab{background:transparent;border:1.5px solid var(--line);border-radius:999px;padding:10px 18px;font-weight:600;cursor:pointer;min-height:46px}
.tab[aria-selected="true"]{background:var(--red);border-color:var(--red);color:#1a0b08}
.tab:focus-visible,.btn:focus-visible,.chip:focus-visible,.mbtn:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
main{display:grid;grid-template-columns:minmax(0,1fr) 390px;gap:16px;min-height:0}
.skywrap{position:relative;min-height:0;display:flex;align-items:center;justify-content:center}
#sky{display:block;touch-action:manipulation;cursor:crosshair}
.turn{position:absolute;top:50%;transform:translateY(-50%);width:64px;height:96px;border-radius:14px;border:1.5px solid rgba(255,255,255,.25);background:rgba(8,12,29,.55);color:var(--ink);font-size:1.9rem;cursor:pointer;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px}
.turn small{font-size:.7rem;font-family:var(--f-body)}
.turn.l{left:10px}.turn.r{right:10px}
.zoomout{position:absolute;top:12px;right:12px;min-height:48px;padding:8px 16px;border-radius:999px;border:1.5px solid var(--red);background:rgba(8,12,29,.75);color:var(--ink);font-weight:600;cursor:pointer}
aside{background:var(--panel);border:1px solid var(--line);border-radius:18px;overflow-y:auto;min-height:0;padding:18px;display:flex;flex-direction:column;gap:16px}
aside section{display:flex;flex-direction:column;gap:16px}
.lbl{font-size:.74rem;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:8px;display:flex;justify-content:space-between;gap:8px}
.lbl small{letter-spacing:0;text-transform:none;font-weight:400}
.months{display:grid;grid-template-columns:repeat(6,1fr);gap:6px}
.mbtn{min-height:44px;border-radius:10px;border:1.5px solid var(--line);background:var(--panel2);cursor:pointer;font-weight:500;font-size:.92rem}
.mbtn[aria-pressed="true"]{border-color:var(--red);background:var(--redsoft);color:#fff}
.season{margin-top:8px;font-size:.88rem;color:var(--muted)}
.season b{color:var(--ink);font-weight:600}
.timerow{display:grid;grid-template-columns:1fr auto 1fr;gap:8px;align-items:center}
.clock{font-family:var(--f-mono);font-size:1.7rem;font-weight:500;text-align:center;min-width:5.2ch;font-variant-numeric:tabular-nums}
.btn{min-height:46px;border-radius:12px;border:1.5px solid var(--line);background:var(--panel2);padding:8px 14px;cursor:pointer;font-weight:500}
.btn.primary{background:var(--red);border-color:var(--red);color:#1a0b08;font-weight:600}
.btn.on{border-color:var(--gold);color:var(--gold)}
.btn:disabled{opacity:.4;cursor:default}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.row1{display:grid;gap:8px}
.dirs{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{min-height:44px;border-radius:999px;border:1.5px solid var(--line);background:transparent;padding:6px 14px;cursor:pointer;font-weight:500}
.chip[aria-pressed="true"]{background:var(--gold);border-color:var(--gold);color:#1d1404}
.sunline{font-size:.9rem;padding:10px 12px;border-radius:12px;background:var(--panel2);border:1px solid var(--line)}
.sunline.day{border-color:#e7b45a;color:#ffe2a6}
.conlist{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:6px}
.conlist button{width:100%;text-align:left;display:flex;flex-direction:column;gap:2px;padding:8px 10px;min-height:52px;border-radius:12px;border:1.5px solid var(--line);background:var(--panel2);cursor:pointer}
.conlist button[aria-pressed="true"]{border-color:var(--gold)}
.conlist .nm{font-weight:600}
.pill{font-size:.72rem;font-weight:600;letter-spacing:.04em}
.pill.v{color:var(--ok)}.pill.p{color:var(--gold)}.pill.h{color:var(--muted)}
.card{background:var(--panel2);border:1px solid var(--line);border-radius:14px;padding:14px;display:flex;flex-direction:column;gap:6px}
.card h3{margin:0;font-family:var(--f-disp);font-weight:500;font-size:1.05rem}
.card p{margin:0}
.card .meta{font-size:.85rem;color:var(--muted)}
.tag{display:inline-block;font-size:.7rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:2px 8px;border-radius:999px;border:1px solid currentColor;margin-right:6px;vertical-align:2px}
.tag.kitap{color:var(--ok)}.tag.ek{color:var(--gold)}.tag.kurgu{color:var(--red)}
.task{display:flex;gap:10px;align-items:flex-start;padding:10px 0;border-top:1px solid var(--line)}
.task:first-child{border-top:0}
.task .box{flex:none;width:24px;height:24px;border-radius:7px;border:2px solid var(--line);display:grid;place-items:center;font-size:.85rem;margin-top:1px}
.task.done .box{background:var(--ok);border-color:var(--ok);color:#06231a}
.task p{margin:0;font-size:.95rem}
.opts{display:grid;gap:6px;margin-top:8px}
.opt{text-align:left;min-height:44px;border-radius:10px;border:1.5px solid var(--line);background:transparent;padding:8px 12px;cursor:pointer}
.opt.right{border-color:var(--ok);background:var(--okSoft)}
.opt.wrong{border-color:var(--bad);color:var(--bad)}
.fb{font-size:.88rem;margin-top:6px;color:var(--muted)}
.lvlbar{display:flex;gap:6px}
.lvl{flex:1;min-height:44px;border-radius:10px;border:1.5px solid var(--line);background:var(--panel2);cursor:pointer;font-family:var(--f-mono);font-weight:500}
.lvl[aria-current="true"]{border-color:var(--red);color:#fff}
.lvl.done{background:var(--okSoft);border-color:var(--ok)}
h2.ttl{margin:0;font-family:var(--f-disp);font-weight:500;font-size:1.2rem;text-wrap:balance}
.story{margin:0;color:var(--muted)}
.steps{list-style:none;margin:0;padding:0;display:grid;gap:6px}
.steps li{display:flex;gap:10px;align-items:center;padding:8px 10px;border-radius:10px;border:1px solid var(--line);font-size:.95rem;color:var(--muted)}
.steps li .n{flex:none;width:26px;height:26px;border-radius:50%;display:grid;place-items:center;border:1.5px solid var(--line);font-family:var(--f-mono);font-size:.85rem}
.steps li.now{border-color:var(--red);color:var(--ink);background:var(--redsoft)}
.steps li.now .n{border-color:var(--red)}
.steps li.ok{color:var(--ink)}
.steps li.ok .n{background:var(--ok);border-color:var(--ok);color:#06231a}
.say{padding:12px 14px;border-radius:12px;border-left:4px solid var(--red);background:var(--panel2);font-size:1rem;min-height:3em}
.say.good{border-left-color:var(--ok)}
.say.warn{border-left-color:var(--bad)}
.quote{font-size:.9rem;color:var(--muted)}
.missions{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}
.news{background:linear-gradient(180deg,var(--panel2),var(--panel));border:1px solid var(--line);border-radius:14px;padding:14px;display:flex;flex-direction:column;gap:8px}
.news .eb{font-family:var(--f-mono);font-size:.78rem;color:var(--red);letter-spacing:.04em}
.news h3{margin:0;font-family:var(--f-disp);font-weight:500;font-size:1.08rem;line-height:1.35;text-wrap:balance}
.news p{margin:0}
.scope{display:flex;flex-direction:column;gap:8px;align-items:stretch}
.scope canvas{width:200px;height:200px;align-self:center;border-radius:50%;box-shadow:0 0 0 6px #1d2547,0 0 0 8px var(--line)}
.scope h4{margin:4px 0 0;font-family:var(--f-disp);font-weight:500;font-size:1.05rem;text-align:center}
.finish{text-align:center;color:var(--ok);font-weight:600}
@media (max-width:900px){
  .app{height:auto;display:flex;flex-direction:column}
  main{display:flex;flex-direction:column}
  aside{overflow:visible}
  .brand h1{font-size:1.2rem}
  .turn{width:52px;height:80px}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>

</head>
<body>
<div class="app">
  <header>
    <div class="brand">
      <h1>Yıldız <span>Pusulası</span></h1>
      <p>7. sınıf · Takımyıldızlar</p>
    </div>
    <nav class="tabs" role="tablist" aria-label="Bölümler">
      <button class="tab" role="tab" id="tab-harita" aria-selected="true">Gök Haritası</button>
      <button class="tab" role="tab" id="tab-orman" aria-selected="false">Ormanda Yön Bul</button>
      <button class="tab" role="tab" id="tab-kesif" aria-selected="false">Keşif Avcısı</button>
    </nav>
  </header>
  <main>
    <div class="skywrap" id="skywrap">
      <canvas id="sky" aria-label="Gökyüzü"></canvas>
      <button class="turn l" id="turnL" hidden aria-label="Sola dön">◀<small>Sola dön</small></button>
      <button class="turn r" id="turnR" hidden aria-label="Sağa dön">▶<small>Sağa dön</small></button>
      <button class="zoomout" id="zoomOut" hidden>⤺ Bütün gökyüzü</button>
    </div>
    <aside id="panel">
      <!-- GÖK HARİTASI -->
      <section id="p-harita">
        <div>
          <div class="lbl">Tarih</div>
          <div class="months" id="months"></div>
          <div class="season" id="season"></div>
        </div>
        <div>
          <div class="lbl">Saat</div>
          <div class="timerow">
            <button class="btn" id="hMinus">− 1 saat</button>
            <output class="clock" id="clock">21:00</output>
            <button class="btn" id="hPlus">+ 1 saat</button>
          </div>
          <div class="row2" style="margin-top:8px">
            <button class="btn" id="playNight">▶ Gece boyunca izle</button>
            <button class="btn" id="playYear">▶ Yıl boyunca izle</button>
          </div>
        </div>
        <div>
          <div class="lbl">Bakış yönü <small>ekranın alt kenarı</small></div>
          <div class="dirs" id="dirsH"></div>
        </div>
        <div>
          <div class="lbl">Göster</div>
          <div class="chips">
            <button class="chip" id="cLines" aria-pressed="true">Çizgiler</button>
            <button class="chip" id="cNames" aria-pressed="true">İsimler</button>
            <button class="chip" id="cPolar" aria-pressed="false">Kutup Yıldızı'na giden yol</button>
          </div>
        </div>
        <div class="sunline" id="sunline"></div>
        <div>
          <div class="lbl">Takımyıldızlar <small>dokun, bilgisini gör</small></div>
          <ul class="conlist" id="conlist"></ul>
        </div>
        <div class="card" id="coninfo"></div>
        <div>
          <div class="lbl">Görevler</div>
          <div id="tasksH"></div>
        </div>
      </section>

      <!-- ORMAN -->
      <section id="p-orman" hidden>
        <div class="lvlbar" id="lvlbar"></div>
        <h2 class="ttl" id="oTitle"></h2>
        <p class="story" id="oStory"></p>
        <ol class="steps" id="oSteps"></ol>
        <div class="say" id="oSay"></div>
        <div class="row2">
          <button class="btn" id="oHint">İpucu</button>
          <button class="btn" id="oSpecial" hidden></button>
        </div>
        <button class="btn primary" id="oWalk" hidden>Bu yöne yürü</button>
        <div class="row2">
          <button class="btn" id="oReset">Geceyi baştan al</button>
          <button class="btn" id="oNext" disabled>Sonraki gece →</button>
        </div>
        <p class="quote"><span class="tag kitap">Kitaptan</span>“Cezvenin uç kısmında bulunan iki yıldızın arasındaki mesafenin 5 kat uzağında yer alan parlak yıldız Kutup Yıldızı'dır. Bu yıldız her zaman kuzey yönünü gösterir.”</p>
      </section>

      <!-- KEŞİF -->
      <section id="p-kesif" hidden>
        <div>
          <div class="lbl">Haberler <small id="kCount"></small></div>
          <div class="missions" id="kList"></div>
        </div>
        <article class="news" id="kNews"></article>
        <div class="say" id="kSay"></div>
        <div class="row2">
          <button class="btn" id="kHint">İpucu</button>
          <button class="btn" id="kNames">İsimleri göster</button>
        </div>
        <div>
          <div class="lbl">Bakış yönü <small>ekranın alt kenarı</small></div>
          <div class="dirs" id="dirsK"></div>
        </div>
        <div class="card scope" id="kScope" hidden>
          <canvas id="scopeCv" width="400" height="400"></canvas>
          <h4 id="kScopeT"></h4>
          <p id="kBook"></p>
          <p id="kExtra"></p>
          <button class="btn primary" id="kNext">Sonraki haber →</button>
        </div>
      </section>
    </aside>
  </main>
</div>

