}
const dot=(a,b)=>a[0]*b[0]+a[1]*b[1]+a[2]*b[2];
const nv=(alt,az)=>[Math.cos(alt*DEG)*Math.cos(az*DEG),Math.cos(alt*DEG)*Math.sin(az*DEG),Math.sin(alt*DEG)];
let _cb=null,_cbk="";
function camBasis(){const k=V.cA+","+V.cE;if(k===_cbk)return _cb;const f=nv(V.cE,V.cA),r=[-Math.sin(V.cA*DEG),Math.cos(V.cA*DEG),0];const u=[f[1]*r[2]-f[2]*r[1],f[2]*r[0]-f[0]*r[2],f[0]*r[1]-f[1]*r[0]];_cbk=k;_cb={f,r,u};return _cb}
function unproj(x,y){ // ekran -> {alt,az}
  if(V.kind==="dome"){const dx=x-V.cx,dy=y-V.cy,r=Math.hypot(dx,dy);const z=2*Math.atan(r/V.R)/DEG;return{alt:90-z,az:((Math.atan2(dx,dy)/DEG+V.F)%360+360)%360}}
  const c=camBasis(),a=(x-V.cx)/V.fpx,b=-(y-V.cy)/V.fpx;const v=c.f.map((q,i)=>q+a*c.r[i]+b*c.u[i]);const l=Math.hypot(...v);
  return{alt:Math.asin(v[2]/l)/DEG,az:((Math.atan2(v[1],v[0])/DEG)+360)%360};
}
function angDist(a1,z1,a2,z2){return Math.acos(Math.max(-1,Math.min(1,dot(nv(a1,z1),nv(a2,z2)))))/DEG}
function pxPerDeg(alt){if(V.kind==="cam")return V.fpx*DEG;if(V.kind==="pano")return V.ppd;const z=(90-(alt??45))*DEG;return V.R/2/Math.cos(z/2)**2*DEG}
